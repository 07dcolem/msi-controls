#!/usr/bin/bash
# Root-owned seat grant for the msi-ec attributes this plugin writes.
# Installed to /usr/local/libexec/io.github.07dcolem.msi-controls/grant.
set -euo pipefail
shopt -s nullglob

grant_file() {
  local path="$1"
  [[ -e $path && ! -L $path && -f $path ]] || return 0
  chgrp wheel -- "$path"
  chmod 0660 -- "$path"
}

grant_file /sys/devices/platform/msi-ec/shift_mode
grant_file /sys/devices/platform/msi-ec/fan_mode
grant_file /sys/devices/platform/msi-ec/cooler_boost
grant_file /sys/devices/platform/msi-ec/webcam
grant_file /sys/devices/platform/msi-ec/webcam_block
grant_file /sys/devices/platform/msi-ec/fn_key
grant_file /sys/devices/platform/msi-ec/win_key
grant_file /sys/devices/platform/msi-ec/super_battery

for path in /sys/class/power_supply/BAT[0-9]/charge_control_end_threshold; do
  grant_file "$path"
done
